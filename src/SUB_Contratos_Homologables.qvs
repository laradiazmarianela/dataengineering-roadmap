        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_employee]);

        [employee_bank_information]:
        LOAD *
        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_bank_information]);

        [bank]:
        LOAD *
        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_bank]);

        [employee_health_insurances]:
        LOAD *
        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_employee_health_insurances]);

        [health_insurance]:
        LOAD *
