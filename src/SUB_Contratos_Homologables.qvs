        LOAD *
        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_privacy_id_in]);

        DROP TABLE RestConnectorMasterTable;

        ContractsBatch:
        NoConcatenate
        LOAD *
        RESIDENT [contracts_data_raw]
        WHERE Len(Trim(id_u22)) > 0;
        DROP TABLE [contracts_data_raw];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [annex_company_contract];
        DROP TABLE [annex_company_contract];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_area];
        DROP TABLE [contract_area];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_company];
        DROP TABLE [contract_company];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_cost_center_contracts];
        DROP TABLE [contract_cost_center_contracts];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_cost_center];
        DROP TABLE [contract_cost_center];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [destructured_antiquity];
        DROP TABLE [destructured_antiquity];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_group_u0];
        DROP TABLE [contract_group_u0];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_metadata];
        DROP TABLE [contract_metadata];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_privacies];
        DROP TABLE [contract_privacies];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_position_u0];
        DROP TABLE [contract_position_u0];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_rfc_data];
        DROP TABLE [contract_rfc_data];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_vacation_type_ids];
        DROP TABLE [contract_vacation_type_ids];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_work_days];
        DROP TABLE [contract_work_days];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [contract_working_days];
        DROP TABLE [contract_working_days];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [employee];
        DROP TABLE [employee];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [employee_bank_information];
        DROP TABLE [employee_bank_information];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [bank];
        DROP TABLE [bank];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [employee_health_insurances];
        DROP TABLE [employee_health_insurances];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [health_insurance];
        DROP TABLE [health_insurance];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [employee_pension_funds];
        DROP TABLE [employee_pension_funds];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [pension_fund];
        DROP TABLE [pension_fund];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [voluntary_pension_saving_account];
        DROP TABLE [voluntary_pension_saving_account];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [person];
        DROP TABLE [person];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [person_area];
        DROP TABLE [person_area];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [person_errors];
        DROP TABLE [person_errors];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [person_position];
        DROP TABLE [person_position];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [person_privacy];
        DROP TABLE [person_privacy];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [user];
        DROP TABLE [user];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [organization_position];
        DROP TABLE [organization_position];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [payroll_fields_as_json];
        DROP TABLE [payroll_fields_as_json];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [role];
        DROP TABLE [role];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [permitted_approval_payroll_options];
        DROP TABLE [permitted_approval_payroll_options];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [permitted_payroll_types];
        DROP TABLE [permitted_payroll_types];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [payroll_configurations];
        DROP TABLE [payroll_configurations];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [payroll_months_applies];
        DROP TABLE [payroll_months_applies];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [role_permissions];
        DROP TABLE [role_permissions];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [workspaces];
        DROP TABLE [workspaces];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [workspace_filters];
        DROP TABLE [workspace_filters];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [workspace_group];
        DROP TABLE [workspace_group];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [workspace_group_nested];
        DROP TABLE [workspace_group_nested];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [workspace_group_id_in];
        DROP TABLE [workspace_group_id_in];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [workspace_privacy];
        DROP TABLE [workspace_privacy];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [workspace_privacy_nested];
        DROP TABLE [workspace_privacy_nested];

        LEFT JOIN (ContractsBatch)
        LOAD *
        RESIDENT [workspace_privacy_id_in];
        DROP TABLE [workspace_privacy_id_in];

        IF FieldNumber('__KEY_data','ContractsBatch') > 0 THEN
            DROP FIELD __KEY_data FROM ContractsBatch;
        ENDIF
        IF FieldNumber('__FK_data','ContractsBatch') > 0 THEN
            DROP FIELD __FK_data FROM ContractsBatch;
        ENDIF

        LET vRows = NoOfRows('ContractsBatch');

        IF vRows = 0 THEN
            DROP TABLE ContractsBatch;
        ELSE
            IF vTablaCreada = 0 THEN
                ContractsHomologables:
                NoConcatenate
                LOAD * RESIDENT ContractsBatch;
                LET vTablaCreada = 1;
            ELSE
                CONCATENATE (ContractsHomologables)
                LOAD * RESIDENT ContractsBatch;
            ENDIF

            DROP TABLE ContractsBatch;
            LET vPage = vPage + 1;
        ENDIF
    LOOP

    IF vTablaCreada = 1 THEN
        STORE ContractsHomologables INTO [lib://Bronce - Script - Rankmi - Diversur:DataFiles/Contracts_Campos_Homologables.qvd] (qvd);
        DROP TABLE ContractsHomologables;
        TRACE *** Contratos Rankmi guardados en QVD ***;
    ELSE
        TRACE *** No se recibieron datos de contratos Rankmi ***;
    ENDIF

    DISCONNECT;
END SUB
