        WHERE NOT IsNull([__FK_voluntary_pension_saving_account]);

        [person]:
        LOAD *
        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_person]);

        [person_area]:
        LOAD *
        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_area_u0]);

        [person_errors]:
        LOAD *
        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_errors]);

        [person_position]:
        LOAD *
        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_position]);

        [person_privacy]:
        LOAD *
        RESIDENT RestConnectorMasterTable
        WHERE NOT IsNull([__FK_privacy]);

        [user]:
        LOAD *
        RESIDENT RestConnectorMasterTable
